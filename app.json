{
  "expo": {
    "name": "Cola Aqui",
    "slug": "cola-aqui",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "colaaqui",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#17211F",
    "ios": {
      "bundleIdentifier": "br.com.colaaqui.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.colaaqui.app",
      "adaptiveIcon": {
        "backgroundColor": "#17211F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17211F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Cola Aqui usa a câmera para você gravar um registro de onde está agora.",
          "microphonePermission": "O Cola Aqui usa o microfone para gravar o som do rolê no seu registro.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Cola Aqui usa sua localização para mostrar o que tá rolando perto de você e confirmar que o registro foi feito no lugar."
        }
      ],
      "expo-video",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
